<resources>
    <!-- 深色模式下使用非 Light 的 Material 父主题，让系统组件（如 DatePicker、TimePicker）默认走深色适配。
         API 29+ 实际命中的是 values-night-v29 变体，这里只管 API 26-28。
         style 变体之间不继承，每份都要把 item 写全，否则会丢掉 splash/窗口背景。 -->
    <style name="Theme.LightXin" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
